{
  "name": "digifunzi-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Public marketing/landing site for Digifunzi. Standalone SPA that talks to the main system over /api/public/*.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run postbuild",
    "postbuild": "node scripts/generate-sitemap.js --mode production && node scripts/prerender.js --mode production",
    "build:spa": "vite build",
    "package": "node scripts/package.js",
    "deploy:build": "npm run build && npm run package",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sitemap": "node scripts/generate-sitemap.js",
    "prerender": "node scripts/prerender.js",
    "verify:pipeline": "vite build --mode mockbuild && node scripts/generate-sitemap.js --mode mockbuild && node scripts/prerender.js --mode mockbuild"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/inter": "^5.1.0",
    "@hookform/resolvers": "^3.10.0",
    "@mui/icons-material": "^6.4.0",
    "@mui/material": "^6.4.0",
    "@tanstack/react-query": "^5.62.0",
    "axios": "^1.7.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.54.0",
    "react-router-dom": "^7.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "puppeteer": "^24.43.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
