# Copy to server/.env and fill in. Loaded by cPanel's "Setup Node.js App"
# (Environment variables section) or via `node --env-file=.env index.js` locally.

# Port the API listens on. cPanel assigns this via the app config UI.
PORT=5050

# Comma-separated list of browser origins allowed to call the API (CORS).
# MUST include the deployed site origin, and localhost for dev.
PUBLIC_SITE_URL=https://africa.digifunzi.com,http://localhost:5175

# /admin submissions viewer. Leave ADMIN_PASSWORD unset to disable /admin.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-strong

# Optional overrides (defaults are ./data and ./data/content relative to CWD).
# On cPanel set DATA_DIR to a path OUTSIDE the web root so leads.json is not
# publicly downloadable, e.g. /home/<cpuser>/digifunzi-data
# DATA_DIR=/home/youruser/digifunzi-data
# CONTENT_DIR=/home/youruser/digifunzi-landing/data/content

# Set to "true" to have this one process also serve the built SPA from dist/
# (single-process deploy — no separate static hosting needed).
SERVE_STATIC=false
