# The website is built twice, once per curriculum system. The real files (.env.production,
# .env.dev) are kept out of git; copy the block for each into its file. None of these are secret —
# they are public addresses baked into the built site.

# ── .env.production → `npm run deploy:build` → Guide/digifunzi-co-ke-dist.zip ─────────────────
# https://digifunzi.co.ke, showing the LIVE system's data.
#   VITE_API_URL=https://dcf-api.digifunzi.com
#   VITE_USE_MOCK=false
#   VITE_SITE_URL=https://digifunzi.co.ke
#   VITE_APP_URL=https://dcf.digifunzi.com

# ── .env.dev → `npm run deploy:build:dev` → Guide/africa-digifunzi-com-dist.zip ───────────────
# https://africa.digifunzi.com, showing the DEV system's data.
#   VITE_API_URL=https://nodeapp.digifunzi.com
#   VITE_USE_MOCK=false
#   VITE_SITE_URL=https://africa.digifunzi.com
#   VITE_APP_URL=https://curriculum.digifunzi.com

# Each API only accepts the forms of sites listed in its own PUBLIC_SITE_URL setting (cPanel →
# Setup Node.js App → that app → Environment variables):
#   Live app (dcf-api):  PUBLIC_SITE_URL=https://digifunzi.co.ke,https://www.digifunzi.co.ke
#   Dev app (nodeapp):   PUBLIC_SITE_URL=https://africa.digifunzi.com

# Local development (`npm run dev`) — put in .env:
#   VITE_API_URL=http://localhost:5000
#   VITE_SITE_URL=http://localhost:5175
